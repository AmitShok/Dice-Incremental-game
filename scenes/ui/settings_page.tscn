[gd_scene format=3]

[node name="SettingsPage" type="VBoxContainer"]
size_flags_horizontal = 3

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "Make yourself comfortable."

[node name="sound" type="Button" parent="."]
layout_mode = 2
text = "Sound effects"

[node name="motion" type="Button" parent="."]
layout_mode = 2
text = "Motion & bounce"

[node name="flashes" type="Button" parent="."]
layout_mode = 2
text = "Counter flashes"

[node name="numbers" type="Button" parent="."]
layout_mode = 2
text = "Floating payouts"

[node name="particles" type="Button" parent="."]
layout_mode = 2
text = "Celebration sparks"

[node name="VolumeLabel" type="Label" parent="."]
layout_mode = 2
text = "Volume"

[node name="Volume" type="HSlider" parent="."]
layout_mode = 2
max_value = 1.0
step = 0.05

[node name="Save" type="Button" parent="."]
layout_mode = 2
text = "Save now"

[node name="Help" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Autosaves every 30 seconds and on exit. Offline earnings: 50% of estimated production, up to four hours."
autowrap_mode = 3

[node name="Reset" type="Button" parent="."]
layout_mode = 2
text = "Reset all progress..."
